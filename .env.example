# OpenAI
OPENAI_API_KEY=
# Verified against openai@7.4.0 (Aug 2026). Snapshot pin: gpt-image-2-2026-04-21
OPENAI_IMAGE_MODEL=gpt-image-2

# Cloudinary (cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=
CLOUDINARY_BASE_FOLDER=linkedin-content-engine

# Buffer
BUFFER_API_KEY=
BUFFER_GRAPHQL_ENDPOINT=https://api.buffer.com
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_ORGANIZATION_ID=
# Set the AI-assisted flag on created posts when the live schema supports it
BUFFER_MARK_AI_ASSISTED=true
# Not recommended: bypass the pre-write schema introspection gate
BUFFER_SKIP_SCHEMA_CHECK=false

# Application
BRAND_PROFILE_PATH=./brand-profile.json
OUTPUT_DIR=.generated
DRY_RUN=true
LOG_LEVEL=info
