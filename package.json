{
  "name": "linkedin-content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code skill + MCP server scaffold for LinkedIn content, GPT Image 2, Cloudinary, and Buffer.",
  "scripts": {
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "verify:buffer": "tsx scripts/verify-buffer-schema.ts",
    "dump:buffer": "tsx scripts/dump-buffer-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
